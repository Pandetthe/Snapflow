{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "Postgres": "",
        "Redis": ""
    },
    "IdentityOptions": {
        "ExpiryMinutes": 15,
        "RefreshExpiryMinutes": 10080,
        "CookieDomain": ""
    },
    "Authentication": {
        "Mode": "Local",
        "AllowExternalSignUp": true,
        "AutoRedirect": false,
        "Google": {
            "Enabled": false,
            "ClientId": "",
            "ClientSecret": ""
        },
        "Microsoft": {
            "Enabled": false,
            "ClientId": "",
            "ClientSecret": "",
            "TenantId": "common"
        },
        "Facebook": {
            "Enabled": false,
            "ClientId": "",
            "ClientSecret": ""
        },
        "GitHub": {
            "Enabled": false,
            "ClientId": "",
            "ClientSecret": ""
        },
        "OpenIdConnect": [],
        "Saml": {
            "Enabled": false,
            "DisplayName": "Single sign-on",
            "EntityId": "",
            "IdpEntityId": "",
            "IdpMetadataUrl": ""
        },
        "Ldap": {
            "Enabled": false,
            "DisplayName": "Company account",
            "Host": "",
            "Port": 389,
            "Security": "StartTls",
            "BindDn": "",
            "BindPassword": "",
            "SearchBase": "",
            "UserFilter": "(&(objectClass=person)(|(uid={0})(mail={0})))",
            "IdAttribute": "entryUUID",
            "EmailAttribute": "mail",
            "NameAttribute": "cn"
        }
    },
    "ExposeHealthChecks": false,
    "Email": {
        "Host": "smtp.example.com",
        "Port": 587,
        "SecureSocketOptions": "Auto",
        "RequireAuthentication": true,
        "Username": "smtp-user",
        "Password": "smtp-password",
        "FromName": "Snapflow",
        "FromEmail": "noreply@snapflow.pl"
    },
    "Services": {
        "ApiUrl": null,
        "WebUrl": null,
        "AllowedOrigins": []
    },
    "Avatar": {
        "MaxFileSize": 5,
        "AllowedExtensions": [".jpg", ".jpeg", ".png", ".gif", ".webp"]
    }
}
